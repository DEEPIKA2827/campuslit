# CampusOS Environment Configuration Example
# Copy this file to .env.local and populate the secrets

# 1. Database Connection (Supabase / PostgreSQL Pooler)
DATABASE_URL="postgresql://postgres.example:password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.example:password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# 2. Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Session Security (Minimum 32 characters for AES-GCM encryption)
AUTH_SESSION_SECRET="campusos_dev_session_secret_change_in_production_32b"

# 4. AI Senior Mentor (Google Gemini API)
# Server-side only. Get a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# 5. Database Connection Pool Limits
DB_MAX_CONNECTIONS="10"
